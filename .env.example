# Lumen Pilot Environment Variables
# Copy to .env and fill in values

# Application
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./lumen_pilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (optional - for advisory features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=30.0

# Keycloak (for production auth)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=